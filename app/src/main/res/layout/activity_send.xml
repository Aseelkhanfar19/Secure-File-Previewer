<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">
    <LinearLayout
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        >
        <TextView
            android:id="@+id/logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/orange"
            android:fontFamily="sans-serif-smallcaps"
            android:gravity="center_horizontal|center_vertical"
            android:padding="40dp"
            android:text="Secure file preview"
            android:textColor="@color/white"
            android:textSize="33dp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerOfUploadFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/navigation"
        app:layout_constraintBottom_toBottomOf="parent"
        >


        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Upload your content"
            android:textColor="#5B5A5A"
            android:textSize="30dp"
            android:textStyle="bold"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="Choose &amp; Upload File"
            app:cornerRadius="5dp"
            android:backgroundTint="@color/orange"
            android:textColor="@color/white"
            android:padding="15dp"
            />

        <TextView
            android:id="@+id/displayPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#5B5A5A"
            android:textSize="18sp"
            android:gravity="center_vertical|center_horizontal"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendFile"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Confirm"
            app:cornerRadius="5dp"
            android:visibility="invisible"
            android:backgroundTint="@color/light_grey"
            android:textColor="@color/orange"
            android:paddingRight="40dp"
            android:paddingLeft="40dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginTop="30dp"
            />

        <TextView
            android:id="@+id/secret_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:textSize="35sp"
            android:gravity="center_vertical|center_horizontal"
            android:textStyle="bold"
            android:visibility="gone"
            android:textIsSelectable="true"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_btn"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Back to Home"
            app:cornerRadius="5dp"
            android:backgroundTint="@color/light_grey"
            android:textColor="@color/orange"
            android:paddingRight="40dp"
            android:paddingLeft="40dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginTop="30dp"
            />






    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>